{
  "name": "Health02 triage model (IND310)",
  "model": "Random forest (tuned)",
  "feature_set": "FS3 + archive knowledge",
  "numeric_features": [
    "interview",
    "is_main",
    "complains",
    "cannot_talk",
    "shame",
    "bleeding",
    "walk_mod",
    "collapse_start",
    "collapse_end",
    "collapse_window",
    "death_start",
    "death_end",
    "has_collapse",
    "has_death_risk",
    "immobile",
    "red_flag_score",
    "p_crit",
    "n_exam",
    "exam_level"
  ],
  "categorical_features": [
    "mobility",
    "collapse_symptom",
    "discomfort",
    "common",
    "avdeling"
  ],
  "uses_DiscomfortLevel": true,
  "decision_weight_w": 3,
